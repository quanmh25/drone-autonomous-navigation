<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parrot_bebop">

  <link name="base_link">
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.503"/> 
      <inertia ixx="0.001805" ixy="-0.0000008619" ixz="0.00001555" 
               iyy="0.001764" iyz="0.0000003595" izz="0.003328"/>
    </inertial>

    <collision>
      <origin xyz="-0.00424 0.00014 -0.00595" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.25 0.07"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_lidar_description/models/my_drone/meshes/hull.dae" scale="0.75 0.75 0.75"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0.06776 -0.08567 -0.00376" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_lidar_description/models/my_drone/meshes/propeller_rr.dae" scale="0.75 0.75 0.75"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="-0.06776 0.08589 -0.00376" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_lidar_description/models/my_drone/meshes/propeller_rl.dae" scale="0.75 0.75 0.75"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="0.06342 -0.08576 -0.00376" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_lidar_description/models/my_drone/meshes/propeller_fr.dae" scale="0.75 0.75 0.75"/>
      </geometry>
    </visual>

    <visual>
      <origin xyz="0.06342 0.08597 -0.00376" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_lidar_description/models/my_drone/meshes/propeller_fl.dae" scale="0.75 0.75 0.75"/>
      </geometry>
    </visual>
  </link>

 
  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <link_name>base_link</link_name>
      <topic>/cmd_vel</topic>
    </plugin>


    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/parrot_bebop/pose</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <link name="lidar_link">
      <visual name='lidar_visual'>
          <origin xyz="0 0 0" rpy=" 0 0 0"/>
          <geometry>
              <box size="0.01 0.01 0.01"/>
          </geometry>
          <material name="red"><color rgba="1 0 0 1"/></material>
      </visual>
      <inertial name="lidar_link_inertial">
        <origin xyz="0 0 0" rpy=" 0 0 0"/>
          <mass value="0.1"/>
          <inertia ixx="1e-3" ixy="0" ixz="0"
                  iyy="1e-3" iyz="0"
                  izz="1e-3"/>
      </inertial>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
              <geometry>
                  <box size="0.01 0.01 0.01"/>
              </geometry>
      </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
      <origin xyz="0.0375 0 0.02625" rpy="0 0 0"/>
      <child link="lidar_link"/>
      <parent link="base_link"/>
      <axis xyz="0 0 1"/>
  </joint>

  <!-- Keep the sensor link as a Gazebo entity as well as a ROS TF frame. -->
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-1.85</min_angle>
              <max_angle>1.85</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <visualize>true</visualize>
      </sensor>
  </gazebo>

</robot>
