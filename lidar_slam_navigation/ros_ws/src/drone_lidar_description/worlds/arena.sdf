<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.10">
  <world name="e2es_indoor">

    <!-- Gazebo plugins -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Physics and environment -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <audio><device>default</device></audio>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg><longitude_deg>0</longitude_deg>
      <elevation>0</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Wooden floor -->
    <model name="my_ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
              <torsional><ode/></torsional>
            </friction>
            <contact><ode/></contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>../models/textures/woodground1024.png</albedo_map>
              <metalness>0.0</metalness><roughness>0.8</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four brick boundary walls -->
    <model name="boundary_walls_10x10">
      <static>true</static>

      <link name="wall_south">
        <pose>0 -5 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.15 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>../models/textures/bricks.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>

      <link name="wall_north">
        <pose>0 5 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.15 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>../models/textures/bricks.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-5 0 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 10 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>../models/textures/bricks.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>5 0 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 10 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>../models/textures/bricks.png</albedo_map><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1 -->
    <model name="unit_box_5">
      <static>true</static>
      <pose>1.5 -2.0 1.25 0 0 0.7</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 1 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2 -->
    <model name="unit_box_13">
      <static>true</static>
      <pose>0.1 3 1.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3 -->
    <model name="unit_box_14">
      <static>true</static>
      <pose>-1.4 0 1.2 0 0 1.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.9 0.35 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.9 0.35 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4 -->
    <model name="unit_box_23">
      <static>true</static>
      <pose>-2.8 -2.3 1.25 0 0 2.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.5 0.4 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.4 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
